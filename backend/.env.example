# --- LLM (any OpenAI-compatible endpoint) ---
# Example for Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1
# Example for Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Check the provider's docs for a currently available free model name.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Embeddings (local, downloaded on first use) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Storage (ChromaDB holds both transcript chunks and session state) ---
CHROMA_PATH=./data/chroma

# --- Limits and behaviour ---
MAX_UPLOAD_MB=2
RETRIEVAL_TOP_K=5
EXTRACTION_CONCURRENCY=2
EXTRACTION_MAX_CHARS=24000
CORS_ORIGINS=http://localhost:5173
